# Copy to .env on the server and fill in.

# Domain Caddy gets an HTTPS certificate for.
SITE_ADDRESS=ws.birbilling.live

# Admin key for creating/editing stations. Make it long and random:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=change-me

LOCAL_TZ=Asia/Kolkata
FRAME_RETENTION_DAYS=7
BACKUP_KEEP=14

# Optional: Telegram message when a station stops sending (and when it's back).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SILENT_ALERT_MINUTES=15

# Nightly camera timelapse (made on the server from the stored photos).
TIMELAPSE_HOUR=1
TIMELAPSE_KEEP_DAYS=30
# Uploads switch on when these files exist in ./secrets on the server:
#   youtube_token.json  (make it with: python tools/youtube_auth.py ...)
#   vimeo.json          {"access_token": "...", "client_id": "...", "client_secret": "..."}
YOUTUBE_PRIVACY=public
